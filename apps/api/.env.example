# Railway API — set these in Railway Variables (Production).
# Phase 4: deploy for /health + optional ops API only.
# Do NOT point the storefront at this API yet (leave NEXT_PUBLIC_API_URL empty on Vercel).
#
# Current Railway public URL (auto-generated; custom api.indiantreks.in comes later):
#   https://api-production-50e73.up.railway.app
# Health: GET /health   Ready: GET /ready

PORT=8080
NODE_ENV=production

# Same Neon PostgreSQL as the Next.js app (ONE database — do not create Railway Postgres)
DATABASE_URL=

# Comma-separated allowed browser origins (tighten after custom domain is live)
CORS_ORIGINS=https://indiantreks.in,https://www.indiantreks.in,http://localhost:3000

# Admin auth for /api/v1/auth + /api/v1/admin/* (REQUIRED if using Railway admin routes)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Customer session (only if/when customer auth is moved to Railway)
USER_SESSION_SECRET=

# Optional Google OAuth (only when customer auth runs on Railway)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Cloudinary (admin media uploads via API)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# Storefront cache invalidation after blog publish (optional until Vercel domain exists)
STOREFRONT_REVALIDATE_URL=https://indiantreks.in/api/revalidate
REVALIDATE_SECRET=
