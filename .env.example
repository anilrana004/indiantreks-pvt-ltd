# Copy to .env.local for local dev. Never commit real secrets.
#
# ============================================================
# PHASE 2 — SAFE PRODUCTION DEPLOY (Vercel monolith)
# ============================================================
# Deploy the EXISTING Next.js app at repo root to ONE Vercel project.
# Leave APP_ROLE empty (full site + admin on one deploy).
# Leave NEXT_PUBLIC_API_URL empty (do NOT cut over to Railway yet).
# Use the SAME Neon DATABASE_URL — do not create a second database.
# Canonical production host: https://indiantreks.in
# Google callback: https://indiantreks.in/api/user/auth/google/callback
# Razorpay webhook: https://indiantreks.in/api/webhooks/razorpay
# Keep RAZORPAY_MODE=test until explicit go-live approval.
#
# Generate secrets (PowerShell):
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Max 256 }) -as [byte[]])
# Or: openssl rand -base64 48
#
# --- Future split (NOT for launch) ---
# When apps/api has payment + customer-auth parity, set NEXT_PUBLIC_API_URL
# and move DATABASE_URL off Vercel. See docs/production-architecture.md.

# Deploy role — omit for both storefront + admin on one server (recommended launch).
# storefront = public site only | admin = admin console only
APP_ROLE=

# External API (Railway) — KEEP EMPTY for safe monolith launch
NEXT_PUBLIC_API_URL=

# Mapbox public token (pk.…) — REQUIRED for trek maps.
NEXT_PUBLIC_MAPBOX_TOKEN=

# Cloudinary — image CDN + admin uploads
CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=

# Admin panel login (REQUIRED strong values on Vercel Production)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# HMAC secret for signed admin sessions (32+ random chars; REQUIRED in production)
ADMIN_SESSION_SECRET=

# Customer (storefront) auth sessions — separate from admin (32+ chars in production)
USER_SESSION_SECRET=

# Optional Google OAuth for customer login (OpenID Connect + PKCE)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional absolute callback override.
# On Vercel Production: leave UNSET (uses live host automatically).
# Never set a localhost value on Vercel.
# Local example only: http://localhost:3000/api/user/auth/google/callback
GOOGLE_REDIRECT_URI=

# PostgreSQL — ONE Neon database for blog/CMS + auth + bookings
# Also accepted: POSTGRES_URL / POSTGRES_PRISMA_URL (Neon Vercel integration).
DATABASE_URL=

# MongoDB — guest reviews (trek / yatra / trip submissions + admin export)
# Atlas connection string, e.g. mongodb+srv://user:pass@cluster.mongodb.net/
MONGODB_URI=
# Optional DB name (defaults to indiantreks)
MONGODB_DB=indiantreks

# Public site URL for canonical links, sitemap, and JSON-LD
NEXT_PUBLIC_SITE_URL=https://indiantreks.in

# Analytics scaffold (optional)
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_GSC_SITE_URL=

# On-demand ISR revalidation (optional; match if using Railway revalidate webhook later)
REVALIDATE_SECRET=

# --- Razorpay (server-only — NEVER use NEXT_PUBLIC_ for secret/webhook) ---
# Mode: test | live  (never mix test keys with live mode)
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MERCHANT_NAME=Indian Treks
RAZORPAY_THEME_COLOR=#00c853
# Optional override for Razorpay Checkout header logo (defaults to the Cloudinary checkout mark)
# RAZORPAY_CHECKOUT_LOGO_URL=
BOOKING_PAYMENT_HOLD_MINUTES=30

# Cron secret for hold expiry worker (Vercel Cron Authorization: Bearer …)
CRON_SECRET=

# --- Transactional email (Brevo) ---
# Required in production for password reset + booking confirmation emails.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=info@indiantreks.in
BREVO_SENDER_NAME=Indian Treks

# --- NOT used by this app today ---
# SMTP_* / RESEND_* — replaced by Brevo for launch
# REDIS_* — not implemented yet; auth rate limits use Postgres (0008_rate_limits.sql)
# In-memory Map limits remain only as a soft secondary on some payment routes
