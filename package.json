{
  "name": "indiantreks",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "dev:api": "npm run dev -w @indiantreks/api",
    "build": "next build",
    "build:api": "npm run build -w @indiantreks/api",
    "start": "next start",
    "start:api": "npm run start -w @indiantreks/api",
    "lint": "eslint",
    "typecheck:api": "npm run typecheck -w @indiantreks/api",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed-knowledge.ts",
    "db:verify": "tsx scripts/verify-foundation.ts",
    "verify:production": "tsx scripts/verify-production.ts",
    "auth:smoke": "tsx scripts/smoke-customer-auth.ts",
    "auth:backup": "tsx scripts/backup-customer-auth.ts",
    "payments:smoke": "tsx scripts/smoke-payments.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.27.0",
    "mapbox-gl": "^3.29.0",
    "mongodb": "^7.6.0",
    "next": "16.2.12",
    "postgres": "^3.4.9",
    "razorpay": "^2.9.8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "swiper": "^14.1.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
